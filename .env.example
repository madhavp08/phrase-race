# Server-only keys (never prefix with VITE_).
# Used by /api/* token + persistence endpoints.

DEEPGRAM_API_KEY=your_deepgram_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Neon Postgres (Vercel Marketplace). Required to persist benchmark runs.
DATABASE_URL=postgres://user:pass@host/neondb

# Comma-separated providers for a round. Deepgram is always included as the
# live gameplay stream. Default is all three.
# VITE_BENCH_PROVIDERS=deepgram,openai,elevenlabs
