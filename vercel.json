{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/runs.ts": {
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": "node_modules/@neondatabase/serverless/**"
    },
    "api/leaderboard.ts": {
      "maxDuration": 10,
      "includeFiles": "node_modules/@neondatabase/serverless/**"
    },
    "api/profile.ts": {
      "maxDuration": 10,
      "includeFiles": "node_modules/@neondatabase/serverless/**"
    },
    "api/models/summary.ts": {
      "maxDuration": 10,
      "includeFiles": "node_modules/@neondatabase/serverless/**"
    }
  }
}
